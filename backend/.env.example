# Backend runtime config
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=lenslight
JWT_SECRET=replace-with-a-long-random-secret

# LLM / AI
# Best choice for this app: Gemini via Google AI Studio
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=your-gemini-api-key

# Optional fallback providers
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Weekly digest cron / webhooks
WEBHOOK_CRON_SECRET=replace-with-a-random-cron-secret

# Frontend URL used by CORS and email deep links
FRONTEND_URL=http://localhost:3000

# Demo login user
DEMO_EMAIL=demo@insightlens.app
DEMO_PASSWORD=replace-with-a-strong-demo-password

# Email delivery
EMAIL_API_KEY=your-email-service-key
EMAIL_FROM_NAME=Lenslight
EMAIL_REPLY_TO=hello@yourdomain.com
